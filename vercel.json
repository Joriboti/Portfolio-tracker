{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/research/applovin",
      "destination": "/en/research/applovin",
      "permanent": true
    },
    {
      "source": "/es/research/applovin",
      "destination": "/en/research/applovin",
      "permanent": true
    },
    {
      "source": "/research/netflix",
      "destination": "/en/research/netflix",
      "permanent": true
    },
    {
      "source": "/es/research/netflix",
      "destination": "/en/research/netflix",
      "permanent": true
    },
    {
      "source": "/research/exor",
      "destination": "/en/research/exor",
      "permanent": true
    },
    {
      "source": "/es/research/exor",
      "destination": "/en/research/exor",
      "permanent": true
    },
    {
      "source": "/research/meta",
      "destination": "/en/research/meta",
      "permanent": true
    },
    {
      "source": "/es/research/meta",
      "destination": "/en/research/meta",
      "permanent": true
    },
    {
      "source": "/fifo-capital-gains-calculator",
      "destination": "/calculadora-fifo",
      "permanent": true
    },
    {
      "source": "/es/fifo-capital-gains-calculator",
      "destination": "/es/calculadora-fifo",
      "permanent": true
    },
    {
      "source": "/en/calculadora-fifo",
      "destination": "/en/fifo-capital-gains-calculator",
      "permanent": true
    },
    {
      "source": "/dcf-calculator",
      "destination": "/calculadora-dcf",
      "permanent": true
    },
    {
      "source": "/es/dcf-calculator",
      "destination": "/es/calculadora-dcf",
      "permanent": true
    },
    {
      "source": "/en/calculadora-dcf",
      "destination": "/en/dcf-calculator",
      "permanent": true
    },
    {
      "source": "/dcf-inverso",
      "destination": "/dcf-invers",
      "permanent": true
    },
    {
      "source": "/reverse-dcf-calculator",
      "destination": "/dcf-invers",
      "permanent": true
    },
    {
      "source": "/es/dcf-invers",
      "destination": "/es/dcf-inverso",
      "permanent": true
    },
    {
      "source": "/es/reverse-dcf-calculator",
      "destination": "/es/dcf-inverso",
      "permanent": true
    },
    {
      "source": "/en/dcf-invers",
      "destination": "/en/reverse-dcf-calculator",
      "permanent": true
    },
    {
      "source": "/en/dcf-inverso",
      "destination": "/en/reverse-dcf-calculator",
      "permanent": true
    },
    {
      "source": "/graham-number-calculator",
      "destination": "/numero-de-graham",
      "permanent": true
    },
    {
      "source": "/es/graham-number-calculator",
      "destination": "/es/numero-de-graham",
      "permanent": true
    },
    {
      "source": "/en/numero-de-graham",
      "destination": "/en/graham-number-calculator",
      "permanent": true
    },
    {
      "source": "/monte-carlo-stock-simulator",
      "destination": "/simulador-monte-carlo",
      "permanent": true
    },
    {
      "source": "/es/monte-carlo-stock-simulator",
      "destination": "/es/simulador-monte-carlo",
      "permanent": true
    },
    {
      "source": "/en/simulador-monte-carlo",
      "destination": "/en/monte-carlo-stock-simulator",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/sobre-trimmtrack",
      "permanent": true
    },
    {
      "source": "/es/about",
      "destination": "/es/sobre-trimmtrack",
      "permanent": true
    },
    {
      "source": "/en/sobre-trimmtrack",
      "destination": "/en/about",
      "permanent": true
    },
    {
      "source": "/privacidad",
      "destination": "/privacitat",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacitat",
      "permanent": true
    },
    {
      "source": "/es/privacitat",
      "destination": "/es/privacidad",
      "permanent": true
    },
    {
      "source": "/es/privacy",
      "destination": "/es/privacidad",
      "permanent": true
    },
    {
      "source": "/en/privacitat",
      "destination": "/en/privacy",
      "permanent": true
    },
    {
      "source": "/en/privacidad",
      "destination": "/en/privacy",
      "permanent": true
    },
    {
      "source": "/terminos",
      "destination": "/termes",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/termes",
      "permanent": true
    },
    {
      "source": "/es/termes",
      "destination": "/es/terminos",
      "permanent": true
    },
    {
      "source": "/es/terms",
      "destination": "/es/terminos",
      "permanent": true
    },
    {
      "source": "/en/termes",
      "destination": "/en/terms",
      "permanent": true
    },
    {
      "source": "/en/terminos",
      "destination": "/en/terms",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "es"
        }
      ],
      "destination": "/es",
      "permanent": true
    },
    {
      "source": "/:path((?!es/|en/|es$|en$).*)",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "es"
        }
      ],
      "destination": "/es/:path",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "en"
        }
      ],
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/:path((?!es/|en/|es$|en$).*)",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "en"
        }
      ],
      "destination": "/en/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/app.html"
    },
    {
      "source": "/:locale(es|en)",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|calculadora-fifo|calculadora-dcf|dcf-invers|numero-de-graham|simulador-monte-carlo|sobre-trimmtrack|privacitat|termes)",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|calculadora-fifo|calculadora-dcf|dcf-invers|numero-de-graham|simulador-monte-carlo|sobre-trimmtrack|privacitat|termes)/:rest*",
      "destination": "/app.html"
    },
    {
      "source": "/es/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|calculadora-fifo|calculadora-dcf|dcf-inverso|numero-de-graham|simulador-monte-carlo|sobre-trimmtrack|privacidad|terminos)",
      "destination": "/app.html"
    },
    {
      "source": "/es/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|calculadora-fifo|calculadora-dcf|dcf-inverso|numero-de-graham|simulador-monte-carlo|sobre-trimmtrack|privacidad|terminos)/:rest*",
      "destination": "/app.html"
    },
    {
      "source": "/en/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|fifo-capital-gains-calculator|dcf-calculator|reverse-dcf-calculator|graham-number-calculator|monte-carlo-stock-simulator|about|privacy|terms|etf-growth-calculator|portfolio-tracker)",
      "destination": "/app.html"
    },
    {
      "source": "/en/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|fifo-capital-gains-calculator|dcf-calculator|reverse-dcf-calculator|graham-number-calculator|monte-carlo-stock-simulator|about|privacy|terms|etf-growth-calculator|portfolio-tracker)/:rest*",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(dashboard|upload|account|auth|debug|verify|how-to-prepare)",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(dashboard|upload|account|auth|debug|verify|how-to-prepare)/:rest*",
      "destination": "/app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/prices-update",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/historical-backfill",
      "schedule": "0 22 * * 6"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/upload",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/upload/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/account",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/account/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/debug",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/debug/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/verify",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/verify/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
