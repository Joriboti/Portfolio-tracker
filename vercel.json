    {
      "source": "/ca/terms",
      "destination": "/ca/termes",
      "permanent": true
    },
    {
      "source": "/es/termes",
      "destination": "/es/terminos",
      "permanent": true
    },
    {
      "source": "/es/terms",
      "destination": "/es/terminos",
      "permanent": true
    },
    {
      "source": "/terminos",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "ca"
        }
      ],
      "destination": "/ca",
      "permanent": true
    },
    {
      "source": "/:path((?!ca/|ca$|es/|es$|research/(?:applovin|netflix|exor|meta)$).*)",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "ca"
        }
      ],
      "destination": "/ca/:path",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "es"
        }
      ],
      "destination": "/es",
      "permanent": true
    },
    {
      "source": "/:path((?!ca/|ca$|es/|es$|research/(?:applovin|netflix|exor|meta)$).*)",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "es"
        }
      ],
      "destination": "/es/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/app.html"
    },
    {
      "source": "/:locale(ca|es)",
      "destination": "/app.html"
    },
    {
      "source": "/ca/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|calculadora-fifo|calculadora-dcf|dcf-invers|numero-de-graham|simulador-monte-carlo|sobre-trimmtrack|privacitat|termes)",
      "destination": "/app.html"
    },
    {
      "source": "/ca/explore/:ticker",
      "destination": "/app.html"
    },
    {
      "source": "/ca/explore/compare/:pair",
      "destination": "/app.html"
    },
    {
      "source": "/ca/research/:slug",
      "destination": "/app.html"
    },
    {
      "source": "/es/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|calculadora-fifo|calculadora-dcf|dcf-inverso|numero-de-graham|simulador-monte-carlo|sobre-trimmtrack|privacidad|terminos)",
      "destination": "/app.html"
    },
    {
      "source": "/es/explore/:ticker",
      "destination": "/app.html"
    },
    {
      "source": "/es/explore/compare/:pair",
      "destination": "/app.html"
    },
    {
      "source": "/es/research/:slug",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|fifo-capital-gains-calculator|dcf-calculator|reverse-dcf-calculator|graham-number-calculator|monte-carlo-stock-simulator|about|privacy|terms|etf-growth-calculator|portfolio-tracker)",
      "destination": "/app.html"
    },
    {
      "source": "/explore/:ticker",
      "destination": "/app.html"
    },
    {
      "source": "/explore/compare/:pair",
      "destination": "/app.html"
    },
    {
      "source": "/research/:slug",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(dashboard|upload|account|auth|debug|verify)",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(dashboard|upload|account|auth|debug|verify)/:rest*",
      "destination": "/app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/prices-update",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/historical-backfill",
      "schedule": "0 22 * * 6"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/dashboard",
