    },
    {
      "source": "/es/explore/sq",
      "destination": "/es/explore/xyz",
      "permanent": true
    },
    {
      "source": "/explore/sq",
      "destination": "/explore/xyz",
      "permanent": true
    },
    {
      "source": "/how-to-prepare",
      "destination": "/upload",
      "permanent": true
    },
    {
      "source": "/ca/research/applovin",
      "destination": "/research/applovin",
      "permanent": true
    },
    {
      "source": "/es/research/applovin",
      "destination": "/research/applovin",
      "permanent": true
    },
    {
      "source": "/ca/research/netflix",
      "destination": "/research/netflix",
      "permanent": true
