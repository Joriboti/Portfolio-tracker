{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/research/applovin",
      "destination": "/en/research/applovin",
      "permanent": true
    },
    {
      "source": "/es/research/applovin",
      "destination": "/en/research/applovin",
      "permanent": true
    },
    {
      "source": "/research/netflix",
      "destination": "/en/research/netflix",
      "permanent": true
    },
    {
      "source": "/es/research/netflix",
      "destination": "/en/research/netflix",
      "permanent": true
    },
    {
      "source": "/research/exor",
      "destination": "/en/research/exor",
      "permanent": true
    },
    {
      "source": "/es/research/exor",
      "destination": "/en/research/exor",
      "permanent": true
    },
    {
      "source": "/research/meta",
      "destination": "/en/research/meta",
      "permanent": true
    },
    {
      "source": "/es/research/meta",
      "destination": "/en/research/meta",
      "permanent": true
    },
    {
      "source": "/fifo-capital-gains-calculator",
      "destination": "/calculadora-fifo",
      "permanent": true
    },
    {
      "source": "/es/fifo-capital-gains-calculator",
      "destination": "/es/calculadora-fifo",
      "permanent": true
    },
    {
      "source": "/en/calculadora-fifo",
      "destination": "/en/fifo-capital-gains-calculator",
      "permanent": true
    },
    {
      "source": "/dcf-calculator",
      "destination": "/calculadora-dcf",
      "permanent": true
    },
    {
      "source": "/es/dcf-calculator",
      "destination": "/es/calculadora-dcf",
      "permanent": true
    },
    {
      "source": "/en/calculadora-dcf",
      "destination": "/en/dcf-calculator",
      "permanent": true
    },
    {
      "source": "/dcf-inverso",
      "destination": "/dcf-invers",
      "permanent": true
    },
    {
      "source": "/reverse-dcf-calculator",
      "destination": "/dcf-invers",
      "permanent": true
    },
    {
      "source": "/es/dcf-invers",
      "destination": "/es/dcf-inverso",
      "permanent": true
    },
    {
      "source": "/es/reverse-dcf-calculator",
      "destination": "/es/dcf-inverso",
      "permanent": true
    },
    {
      "source": "/en/dcf-invers",
      "destination": "/en/reverse-dcf-calculator",
      "permanent": true
    },
    {
      "source": "/en/dcf-inverso",
      "destination": "/en/reverse-dcf-calculator",
      "permanent": true
    },
    {
      "source": "/graham-number-calculator",
      "destination": "/numero-de-graham",
      "permanent": true
    },
    {
      "source": "/es/graham-number-calculator",
      "destination": "/es/numero-de-graham",
      "permanent": true
    },
    {
      "source": "/en/numero-de-graham",
      "destination": "/en/graham-number-calculator",
      "permanent": true
    },
    {
      "source": "/monte-carlo-stock-simulator",
      "destination": "/simulador-monte-carlo",
      "permanent": true
    },
    {
      "source": "/es/monte-carlo-stock-simulator",
      "destination": "/es/simulador-monte-carlo",
      "permanent": true
    },
    {
      "source": "/en/simulador-monte-carlo",
      "destination": "/en/monte-carlo-stock-simulator",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "es"
        }
      ],
      "destination": "/es",
      "permanent": true
    },
    {
      "source": "/:path((?!es/|en/|es$|en$).*)",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "es"
        }
      ],
      "destination": "/es/:path",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "en"
        }
      ],
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/:path((?!es/|en/|es$|en$).*)",
      "has": [
        {
          "type": "query",
          "key": "lng",
          "value": "en"
        }
      ],
      "destination": "/en/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/app.html"
    },
    {
      "source": "/:locale(es|en)",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|calculadora-fifo|calculadora-dcf|dcf-invers|numero-de-graham|simulador-monte-carlo)",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|calculadora-fifo|calculadora-dcf|dcf-invers|numero-de-graham|simulador-monte-carlo)/:rest*",
      "destination": "/app.html"
    },
    {
      "source": "/es/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|calculadora-fifo|calculadora-dcf|dcf-inverso|numero-de-graham|simulador-monte-carlo)",
      "destination": "/app.html"
    },
    {
      "source": "/es/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|calculadora-fifo|calculadora-dcf|dcf-inverso|numero-de-graham|simulador-monte-carlo)/:rest*",
      "destination": "/app.html"
    },
    {
      "source": "/en/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|fifo-capital-gains-calculator|dcf-calculator|reverse-dcf-calculator|graham-number-calculator|monte-carlo-stock-simulator|etf-growth-calculator|portfolio-tracker)",
      "destination": "/app.html"
    },
    {
      "source": "/en/:seg(explore|research|forecast|taxes|radiografia|disclaimer|404|fifo-capital-gains-calculator|dcf-calculator|reverse-dcf-calculator|graham-number-calculator|monte-carlo-stock-simulator|etf-growth-calculator|portfolio-tracker)/:rest*",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(dashboard|upload|account|auth|debug|verify|how-to-prepare)",
      "destination": "/app.html"
    },
    {
      "source": "/:seg(dashboard|upload|account|auth|debug|verify|how-to-prepare)/:rest*",
      "destination": "/app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/prices-update",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/historical-backfill",
      "schedule": "0 22 * * 6"
    }
  ]
}
