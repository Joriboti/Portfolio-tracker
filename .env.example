# Copy this file to .env.local and fill in real values for local development.
# In production, configure these in Vercel → Project Settings → Environment Variables.

# --- Frontend (must be prefixed VITE_ to be exposed to the browser) ---

# Public Auth URL from Neon Auth (Console → Auth → Project Info → Auth URL)
VITE_NEON_AUTH_URL=https://your-project.neonauth.example.aws.neon.tech/neondb/auth

# --- Backend (server-only, never exposed to the browser) ---

# Postgres connection string from Neon (Console → Connection Details)
# Use the pooled connection string for serverless functions.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Same as VITE_NEON_AUTH_URL but available to API routes.
NEON_AUTH_URL=https://your-project.neonauth.example.aws.neon.tech/neondb/auth

# Optional: secret used to authenticate Vercel Cron callbacks.
# When set, cron requests must include `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Notion CMS for the public /research section (see api/_research-core.ts).
# Internal integration token + the "TrimmTrack Research" database id.
NOTION_API_KEY=
NOTION_RESEARCH_DB_ID=
